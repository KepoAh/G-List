<UserControl x:Class="TodoApp.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TodoApp.Views" SizeChanged="View_SizeChanged">
 <UserControl.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,16,16"/></Style>
  <Style x:Key="CardHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="Help" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource ForegroundDimBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,0"/></Style>
  <Style x:Key="Switch" TargetType="CheckBox">
   <Setter Property="Width" Value="46"/><Setter Property="Height" Value="26"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Track" Background="{StaticResource SurfaceLightBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="3">
     <Ellipse x:Name="Dot" Width="18" Height="18" HorizontalAlignment="Left" Fill="{StaticResource ForegroundDimBrush}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{StaticResource AccentSurface}"/><Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource ForegroundBrush}"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.8"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid x:Name="Cards" Margin="0,0,-4,0">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="PreferencesCard" Style="{StaticResource Card}">
    <StackPanel>
     <TextBlock Text="{local:T 'Preferensi aplikasi'}" Style="{StaticResource CardHeading}"/>
     <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><TextBlock Text="{local:T 'Bahasa'}" FontWeight="SemiBold"/><TextBlock Text="{local:T 'Pilih bahasa antarmuka.'}" Style="{StaticResource Help}"/></StackPanel>
      <ComboBox Grid.Column="1" Width="154" VerticalAlignment="Center" Style="{StaticResource PremiumComboBox}" SelectedValuePath="Tag" SelectedValue="{Binding Language}" AutomationProperties.Name="{local:T 'Bahasa'}"><ComboBoxItem Content="Bahasa Indonesia" Tag="id"/><ComboBoxItem Content="English" Tag="en"/></ComboBox>
     </Grid>
     <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0"><TextBlock Text="{local:T 'Mulai bersama Windows'}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{local:T 'G-list berjalan tenang di system tray.'}" Style="{StaticResource Help}"/></StackPanel>
      <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Startup}" AutomationProperties.Name="{local:T 'Mulai bersama Windows'}"/>
     </Grid></Border>
     <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0"><TextBlock Text="{local:T 'Widget selalu di atas'}" FontWeight="SemiBold"/><TextBlock Text="{local:T 'Pertahankan widget di atas jendela lain.'}" Style="{StaticResource Help}"/></StackPanel>
      <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding AlwaysOnTop}" AutomationProperties.Name="{local:T 'Widget selalu di atas'}"/>
     </Grid></Border>
    </StackPanel>
   </Border>
   <Border x:Name="SoundCard" Grid.Column="1" Style="{StaticResource Card}">
    <StackPanel>
     <TextBlock Text="{local:T 'Suara pengingat'}" Style="{StaticResource CardHeading}"/>
     <TextBlock Text="{local:T 'File audio default'}" Style="{StaticResource Caption}"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Style="{StaticResource PremiumTextBox}" Text="{Binding DefaultSoundName,Mode=OneWay}" ToolTip="{Binding DefaultSound}" IsReadOnly="True" Margin="0,0,8,0"/><Button Grid.Column="1" Style="{StaticResource PremiumButton}" Content="{local:T 'Pilih MP3'}" Command="{Binding BrowseDefaultSoundCommand}"/></Grid>
     <Grid Margin="0,18,0,8"><TextBlock Text="Volume"/><TextBlock Text="{Binding Volume,StringFormat={}{0:P0}}" Foreground="{StaticResource ForegroundDimBrush}" HorizontalAlignment="Right"/></Grid>
     <Slider Minimum="0" Maximum="1" Value="{Binding Volume}" AutomationProperties.Name="Volume"/>
     <WrapPanel Margin="0,18,0,0"><Button Style="{StaticResource PremiumButton}" Command="{Binding TestSoundCommand}" Content="{local:T 'Tes suara'}" Margin="0,0,8,8"/><Button Style="{StaticResource QuietButton}" Command="{Binding StopTestSoundCommand}" Content="{local:T 'Hentikan tes'}" Margin="0,0,0,8"/></WrapPanel>
     <Button Style="{StaticResource QuietButton}" Command="{Binding PreviewReminderCommand}" Content="{local:T 'Preview reminder'}" HorizontalAlignment="Left"/>
    </StackPanel>
   </Border>
   <Border x:Name="BackupCard" Grid.Row="1" Style="{StaticResource Card}">
    <StackPanel>
     <TextBlock Text="{local:T 'Backup dan pemulihan'}" Style="{StaticResource CardHeading}"/>
     <TextBlock Text="{local:T 'Simpan salinan database tugas atau pulihkan backup sebelumnya.'}" Style="{StaticResource Help}" Margin="0,0,0,18"/>
     <WrapPanel><Button Style="{StaticResource PremiumButton}" Content="{local:T 'Cadangkan tugas'}" Command="{Binding BackupDatabaseCommand}" Margin="0,0,8,8"/><Button Style="{StaticResource PremiumButton}" Content="{local:T 'Pulihkan backup'}" Command="{Binding RestoreDatabaseCommand}" Margin="0,0,0,8"/></WrapPanel>
    </StackPanel>
   </Border>
   <Border x:Name="DataCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
    <StackPanel>
     <TextBlock Text="{local:T 'Lokasi data'}" Style="{StaticResource CardHeading}"/>
     <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><TextBlock Text="{Binding DataLocation}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource ForegroundDimBrush}"/></Border>
     <TextBlock Text="G-list 1.4.1" Style="{StaticResource Help}" Margin="0,16,0,4"/>
     <TextBlock Text="{local:T 'Data tersimpan lokal di perangkat ini.'}" Style="{StaticResource Help}"/>
    </StackPanel>
   </Border>
  </Grid>
 </ScrollViewer>
</UserControl>
