<UserControl x:Class="TodoApp.Views.TaskEditor" IsVisibleChanged="Editor_VisibleChanged" PreviewKeyDown="Editor_KeyDown" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TodoApp.Views">
    <Grid>
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
      <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding ConfirmationRequired}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><Grid Margin="0,0,0,16"><TextBlock Text="{Binding SaveLabel}" FontSize="22" FontWeight="SemiBold"/><Button Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="30" Height="30" Padding="0" Command="{Binding CancelCommand}" ToolTip="{local:T 'Tutup'}"/></Grid><TextBox x:Name="TitleInput" Style="{StaticResource PremiumTextBox}" Text="{Binding Title,UpdateSourceTrigger=PropertyChanged}" Tag="{local:T 'Tambah tugas cepat...'}" MaxLength="180" GotKeyboardFocus="Title_Focus" KeyDown="Title_KeyDown"/></StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" Visibility="{Binding IsExpanded,Converter={StaticResource BoolToVis}}"><StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="{local:T 'Deskripsi'}"/>
                <TextBox Style="{StaticResource PremiumTextBox}" Text="{Binding Notes,UpdateSourceTrigger=PropertyChanged}" Height="72" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" MaxLength="5000" Tag="{local:T 'Detail kegiatan atau langkah berikutnya...'}" Margin="0,0,0,5"/>
                <TextBlock Style="{StaticResource Caption}" Text="{local:T 'Rentang tenggat · tanggal bisa disesuaikan'}"/>
                <ComboBox Style="{StaticResource PremiumComboBox}" ItemsSource="{Binding PriorityOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Priority}" Margin="0,0,0,5"/>
                <CheckBox Content="{local:T 'Gunakan deadline'}" Foreground="{StaticResource ForegroundDimBrush}" IsChecked="{Binding UseDeadline}" FontSize="12" Margin="0,0,0,4"/>
                <Grid IsEnabled="{Binding UseDeadline}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource Caption}" Text="{local:T 'Tanggal'}"/><DatePicker Style="{StaticResource PremiumDatePicker}" SelectedDate="{Binding Date}" Language="id-ID"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Caption}" Text="{local:T 'Jam (24 jam)'}"/><TextBox Style="{StaticResource PremiumTextBox}" Text="{Binding Time,UpdateSourceTrigger=PropertyChanged}" MaxLength="5" Tag="17:00"/></StackPanel>
                </Grid>
                <Grid Margin="0,5,0,5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox Style="{StaticResource PremiumComboBox}" ItemsSource="{Binding ReminderOptions}" DisplayMemberPath="Label" SelectedValuePath="Minutes" SelectedValue="{Binding ReminderMinutes}" IsEnabled="{Binding UseDeadline}" ToolTip="{local:T 'Waktu pengingat'}"/>
                    <Button Grid.Column="1" Style="{StaticResource QuietButton}" Command="{Binding BrowseSoundCommand}" Content="♫" FontSize="18" ToolTip="{Binding SoundLabel}" AutomationProperties.Name="{local:T 'Pilih suara pengingat'}" Margin="5,0,0,0"/>
                </Grid>
                <Border Background="{StaticResource SurfaceLightBrush}" CornerRadius="8" Padding="10" Margin="0,4,0,8"><TextBlock Text="{Binding ScheduleSummary}" Foreground="{StaticResource ForegroundDimBrush}" FontSize="11" TextWrapping="Wrap"/></Border>
                <TextBlock Text="{Binding Error}" Foreground="#FFB1A5" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6"/>
                </StackPanel></ScrollViewer><StackPanel Grid.Row="2" Margin="0,8,0,0" Visibility="{Binding IsExpanded,Converter={StaticResource BoolToVis}}" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource QuietButton}" Content="{local:T 'Tutup'}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource AccentButton}" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}"/>
                </StackPanel>
        </Grid>
    </Border>
    <Border IsVisibleChanged="Confirmation_VisibleChanged" KeyboardNavigation.TabNavigation="Cycle" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Visibility="{Binding ConfirmationRequired,Converter={StaticResource BoolToVis}}">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{local:T 'Kategori berbeda dari tanggal'}" Foreground="{StaticResource ForegroundBrush}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding ConfirmationText}" Foreground="{StaticResource ForegroundDimBrush}" TextWrapping="Wrap" Margin="0,12"/>
        <Button Style="{StaticResource AccentButton}" x:Name="AutoChoice" Content="{local:T 'Ikuti kategori otomatis'}" Command="{Binding AutoPriorityCommand}" Margin="0,0,0,8"/>
        <Button Style="{StaticResource PremiumButton}" Content="{local:T 'Tetap gunakan pilihan manual'}" Command="{Binding KeepPriorityCommand}" Margin="0,0,0,8"/>
        <Button Style="{StaticResource QuietButton}" Content="{local:T 'Kembali mengedit'}" Command="{Binding BackCommand}"/>
      </StackPanel>
    </Border>
    </Grid>
</UserControl>

