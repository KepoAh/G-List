<UserControl x:Class="TodoApp.Views.ConfirmationOverlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TodoApp.Views" IsVisibleChanged="Overlay_VisibleChanged" PreviewKeyDown="Overlay_KeyDown" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
 <Grid Background="#BD0B111A">
  <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22" Margin="16" MaxWidth="420" VerticalAlignment="Center">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
     <Border Width="42" Height="42" CornerRadius="12" Background="#402B31" HorizontalAlignment="Left" Margin="0,0,0,14"><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource PriorityHeavyBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="{Binding ConfirmationTitle}" Foreground="{StaticResource ForegroundBrush}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200"><StackPanel>
     <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12"><TextBlock Text="{Binding ConfirmationItem}" Foreground="{StaticResource ForegroundBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/></Border>
     <TextBlock Text="{Binding ConfirmationDescription}" Foreground="{StaticResource ForegroundDimBrush}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding ConfirmationError}" Foreground="{StaticResource PriorityHeavyBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel></ScrollViewer>
    <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button x:Name="CancelButton" Content="{local:T 'Batal'}" Style="{StaticResource PremiumButton}" Command="{Binding CancelConfirmationCommand}"/>
     <Button Grid.Column="2" Content="{Binding ConfirmationActionLabel}" Style="{StaticResource AccentButton}" Background="#FF8585" Foreground="#351217" Command="{Binding ConfirmActionCommand}"/>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</UserControl>
