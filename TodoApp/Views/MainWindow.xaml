<Window x:Class="TodoApp.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TodoApp.Views"
 Title="G-list" Width="410" Height="680" MinWidth="360" MinHeight="480" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Topmost="{Binding AlwaysOnTop}" WindowStartupLocation="Manual" Left="40" Top="40">
 <Border TextElement.Foreground="{StaticResource ForegroundBrush}" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Style="{StaticResource ModalBackground}" Background="{StaticResource SurfaceBrush}" CornerRadius="18,18,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,14" MouseLeftButtonDown="DragHeader">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Image Source="{StaticResource BrandImage}" Width="30" Height="30"/>
     <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="G-list" FontWeight="SemiBold"/><TextBlock Text="{Binding TodayLabel}" Foreground="{StaticResource ForegroundDimBrush}" FontSize="11"/></StackPanel>
     <Button Grid.Column="2" Width="32" Height="32" Padding="0" VerticalAlignment="Center" Style="{StaticResource QuietButton}" Command="{Binding ToggleAlwaysOnTopCommand}" ToolTip="{local:T 'Selalu di atas'}" AutomationProperties.Name="{local:T 'Sematkan widget'}">
      <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE718;"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource ForegroundDimBrush}"/><Style.Triggers><DataTrigger Binding="{Binding AlwaysOnTop}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Button>
     <Button Grid.Column="3" Width="32" Height="32" Padding="0" VerticalAlignment="Center" Style="{StaticResource QuietButton}" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" Click="Hide_Click" ToolTip="{local:T 'Sembunyikan ke tray'}"/>
    </Grid>
   </Border>
   <Grid Grid.Row="1" Margin="18,16,18,10" Style="{StaticResource ModalBackground}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
     <RadioButton Style="{StaticResource NavRadio}" Content="{local:T 'Tugas'}" IsChecked="{Binding WidgetMode,Converter={StaticResource Equals},ConverterParameter=Tasks}"/>
     <RadioButton Style="{StaticResource NavRadio}" Content="Schedule" IsChecked="{Binding WidgetMode,Converter={StaticResource Equals},ConverterParameter=Schedule}" Margin="8,0,0,0"/>
    </StackPanel>
   <Grid Grid.Row="1" Visibility="{Binding ShowWidgetTasks,Converter={StaticResource BoolToVis}}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="{local:T 'Semua tugas'}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource ForegroundDimBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
    <Button Grid.Row="1" Style="{StaticResource PremiumButton}" Content="{local:T '＋  Tambah tugas cepat…'}" HorizontalContentAlignment="Left" Command="{Binding Editor.OpenCommand}" Height="48" Margin="0,0,0,8"/>
    <TextBlock Grid.Row="2" Text="{local:T 'DAFTAR TUGAS'}" Style="{StaticResource Caption}" FontSize="11" Margin="0,18,0,0"/>
    <ListView Grid.Row="3" Style="{StaticResource TaskListStyle}" ItemsSource="{Binding Todos}" ItemTemplate="{StaticResource TaskRow}"/>
    <StackPanel Grid.Row="3" VerticalAlignment="Center" Visibility="{Binding IsEmpty,Converter={StaticResource BoolToVis}}" Margin="12">
     <TextBlock Text="{local:T 'Ruang untuk langkah berikutnya.'}" TextAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="{local:T 'Tambahkan tugas pertamamu di atas.'}" TextAlignment="Center" Foreground="{StaticResource ForegroundDimBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </Grid>

    <Grid Grid.Row="1" Visibility="{Binding ShowWidgetSchedules,Converter={StaticResource BoolToVis}}">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,14"><TextBlock Text="{local:T 'Schedule hari ini'}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{local:T 'Jadwal dikelola melalui dashboard.'}" Foreground="{StaticResource ForegroundDimBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding UpcomingSchedules}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,14"><StackPanel>
       <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding WhenLabel}" Foreground="{StaticResource AccentBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6"/>
       <TextBlock Text="{Binding Notes}" Foreground="{StaticResource ForegroundDimBrush}" FontSize="12" TextWrapping="Wrap" MaxHeight="54"/>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     <TextBlock Grid.Row="1" Text="{local:T 'Schedule hari ini kosong.'}" TextWrapping="Wrap" Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasNoSchedules,Converter={StaticResource BoolToVis}}"/>
     <Button Grid.Row="2" Style="{StaticResource QuietButton}" Content="{local:T 'Kelola Schedule di dashboard'}" Command="{Binding OpenScheduleDashboardCommand}" Margin="0,10,0,0"/>
    </Grid>
   </Grid>
   <Border Grid.Row="2" Style="{StaticResource ModalBackground}" Background="{StaticResource SurfaceBrush}" CornerRadius="0,0,18,18" Padding="18,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
    <Button Style="{StaticResource PremiumButton}" Background="{StaticResource AccentSurface}" Foreground="{StaticResource AccentBrush}" Content="{local:T 'Buka dashboard penuh  ↗'}" Command="{Binding OpenDashboardCommand}"/>
   </Border>
  <Grid Grid.RowSpan="3" Panel.ZIndex="20" Background="#B3111821" Visibility="{Binding Editor.IsExpanded,Converter={StaticResource BoolToVis}}" KeyboardNavigation.TabNavigation="Cycle">
    <local:TaskEditor DataContext="{Binding Editor}" Margin="12" MaxWidth="560" MaxHeight="540" VerticalAlignment="Center"/>
  </Grid>
  <Border Grid.Row="1" Panel.ZIndex="15" VerticalAlignment="Bottom" Margin="18" Padding="12" CornerRadius="10" Background="{StaticResource AccentSurface}" Visibility="{Binding HasToast,Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding Toast}" TextWrapping="Wrap"/></Border>
  <local:ConfirmationOverlay Grid.RowSpan="3" Panel.ZIndex="30" Visibility="{Binding IsConfirmationOpen,Converter={StaticResource BoolToVis}}"/>
  </Grid>
 </Border>
</Window>

