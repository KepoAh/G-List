<Window x:Class="TodoApp.Views.NotificationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TodoApp.Views"
 Title="G-list — Pengingat" Width="420" Height="370" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ResizeMode="NoResize" WindowStartupLocation="Manual" MouseLeftButtonDown="Window_MouseLeftButtonDown">
 <Border TextElement.Foreground="{StaticResource ForegroundBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><TextBlock Text="{local:T 'G-list · Pengingat tugas'}" Foreground="{StaticResource AccentBrush}" FontSize="12" VerticalAlignment="Center"/><Button Grid.Column="1" Style="{StaticResource QuietButton}" Command="{Binding MuteCommand}" Content="{Binding MuteLabel}"/><Button Grid.Column="2" Style="{StaticResource QuietButton}" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Padding="0" Click="Close_Click" ToolTip="{local:T 'Tutup'}"/></Grid>
   <StackPanel Grid.Row="1">
    <Border Background="{StaticResource AccentSurface}" CornerRadius="6" Padding="8,5" Margin="0,0,0,10" Visibility="{Binding IsPreview,Converter={StaticResource BoolToVis}}"><TextBlock Text="{local:T 'Preview · tidak mengubah tugas'}" FontSize="11" Foreground="{StaticResource AccentBrush}"/></Border>
    <TextBlock Text="{Binding Todo.Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="58" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="{Binding Todo.Notes}" Foreground="{StaticResource ForegroundDimBrush}" FontSize="12" TextWrapping="Wrap" MaxHeight="45" Margin="0,8"/>
    <TextBlock Text="{Binding Todo.DeadlineLabel}" Foreground="{StaticResource AccentBrush}" FontSize="12"/>
    <TextBlock Text="{Binding Todo.EffectivePriority}" Foreground="{StaticResource ForegroundDimBrush}" FontSize="11" Margin="0,5"/>
    <TextBlock Text="{Binding PreviewFeedback}" Foreground="{StaticResource AccentBrush}" FontSize="11" TextWrapping="Wrap" Visibility="{Binding IsPreview,Converter={StaticResource BoolToVis}}"/>
   </StackPanel>
   <StackPanel Grid.Row="2" Margin="0,12"><TextBlock Text="{local:T 'Tunda pengingat'}" Style="{StaticResource Caption}"/><UniformGrid Columns="4"><Button Style="{StaticResource PremiumButton}" Content="{local:T '15 mnt'}" Command="{Binding SnoozeCommand}" CommandParameter="15" Padding="5,7" Margin="0,0,5,0"/><Button Style="{StaticResource PremiumButton}" Content="{local:T '30 mnt'}" Command="{Binding SnoozeCommand}" CommandParameter="30" Padding="5,7" Margin="0,0,5,0"/><Button Style="{StaticResource PremiumButton}" Content="{local:T '45 mnt'}" Command="{Binding SnoozeCommand}" CommandParameter="45" Padding="5,7" Margin="0,0,5,0"/><Button Style="{StaticResource PremiumButton}" Content="{local:T '1 jam'}" Command="{Binding SnoozeCommand}" CommandParameter="60" Padding="5,7"/></UniformGrid></StackPanel>
   <UniformGrid Grid.Row="3" Columns="2"><Button Style="{StaticResource PremiumButton}" Content="{local:T 'Mulai kerja'}" Command="{Binding StartWorkingCommand}" Margin="0,0,8,0"/><Button Style="{StaticResource AccentButton}" Content="{local:T 'Selesai'}" Command="{Binding CompleteCommand}"/></UniformGrid>
  </Grid>
 </Border>
</Window>
