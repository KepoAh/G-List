<Window x:Class="TodoApp.Views.DashboardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TodoApp.Views"
 Title="G-list — Dashboard" Width="1080" Height="740" MinWidth="780" MinHeight="560" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Border x:Name="Shell" Background="{StaticResource SurfaceBrush}" TextElement.Foreground="{StaticResource ForegroundBrush}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center"><Image Source="{StaticResource BrandImage}" Width="24" Height="24"/><TextBlock Text="G-list" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{local:T 'Minimalkan'}"/>
    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="{local:T 'Maksimalkan / pulihkan'}"/>
    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="{local:T 'Tutup dashboard'}"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Style="{StaticResource ModalBackground}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel Margin="10,14,10,12">
    <StackPanel DockPanel.Dock="Bottom">
     <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="2,12,2,14" Padding="8,12,0,0"><StackPanel><TextBlock Text="{Binding ActiveSummary}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{local:T 'Deadline terdekat lebih dulu'}" FontSize="10" Margin="0,4,0,0" Foreground="{StaticResource ForegroundDimBrush}"/></StackPanel></Border>
     <RadioButton Style="{StaticResource NavRadio}" IsChecked="{Binding SelectedFilter,Converter={StaticResource Equals},ConverterParameter=Settings}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,12,0"/><TextBlock Text="{local:T 'Pengaturan'}"/></StackPanel></RadioButton>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <TextBlock Text="{Binding TodayLabel}" FontSize="11" Margin="8,0,0,4" TextWrapping="Wrap"/><TextBlock Text="{Binding ClockLabel}" FontSize="10" Foreground="{StaticResource ForegroundDimBrush}" Margin="8,0,0,18"/>
     <Button Style="{StaticResource QuietButton}" Command="{Binding ShowWidgetCommand}" Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A7;" Margin="0,0,10,0"/><TextBlock Text="{local:T 'Buka widget'}"/></StackPanel></Button>
     <Button Style="{StaticResource AccentButton}" Command="{Binding Editor.OpenCommand}" Margin="0,0,0,26"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" Margin="0,0,8,0"/><TextBlock Text="{local:T 'Tambah tugas'}"/></StackPanel></Button>
     <TextBlock Text="{local:T 'RUANG TUGAS'}" FontSize="10" Foreground="{StaticResource ForegroundDimBrush}" Margin="8,0,0,10"/>
     <RadioButton Style="{StaticResource NavRadio}" IsChecked="{Binding SelectedFilter,Converter={StaticResource Equals},ConverterParameter=All}" ToolTip="{local:T 'Semua tugas'}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" VerticalAlignment="Center" Foreground="{StaticResource ForegroundDimBrush}"/><TextBlock Grid.Column="1" Text="{local:T 'Semua tugas'}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource ForegroundDimBrush}"/><Border Grid.Column="2" Background="{StaticResource BackgroundBrush}" CornerRadius="8" MinWidth="20" Padding="4,2"><TextBlock Text="{Binding ActiveCount}" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource ForegroundDimBrush}"/></Border></Grid></RadioButton>
     <RadioButton Style="{StaticResource NavRadio}" IsChecked="{Binding SelectedFilter,Converter={StaticResource Equals},ConverterParameter=Heavy}" ToolTip="{local:T '1–7 hari'}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" VerticalAlignment="Center" Foreground="{StaticResource PriorityHeavyBrush}"/><TextBlock Grid.Column="1" Text="Heavy" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource PriorityHeavyBrush}"/><Border Grid.Column="2" Background="{StaticResource BackgroundBrush}" CornerRadius="8" MinWidth="20" Padding="4,2"><TextBlock Text="{Binding HeavyCount}" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource PriorityHeavyBrush}"/></Border></Grid></RadioButton>
     <RadioButton Style="{StaticResource NavRadio}" IsChecked="{Binding SelectedFilter,Converter={StaticResource Equals},ConverterParameter=Medium}" ToolTip="{local:T '8–14 hari'}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE823;" VerticalAlignment="Center" Foreground="{StaticResource PriorityMediumBrush}"/><TextBlock Grid.Column="1" Text="Medium" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource PriorityMediumBrush}"/><Border Grid.Column="2" Background="{StaticResource BackgroundBrush}" CornerRadius="8" MinWidth="20" Padding="4,2"><TextBlock Text="{Binding MediumCount}" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource PriorityMediumBrush}"/></Border></Grid></RadioButton>
     <RadioButton Style="{StaticResource NavRadio}" IsChecked="{Binding SelectedFilter,Converter={StaticResource Equals},ConverterParameter=Light}" ToolTip="{local:T 'Lebih dari 14 hari'}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73A;" VerticalAlignment="Center" Foreground="{StaticResource PriorityLightBrush}"/><TextBlock Grid.Column="1" Text="Light" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource PriorityLightBrush}"/><Border Grid.Column="2" Background="{StaticResource BackgroundBrush}" CornerRadius="8" MinWidth="20" Padding="4,2"><TextBlock Text="{Binding LightCount}" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource PriorityLightBrush}"/></Border></Grid></RadioButton>
     <RadioButton Style="{StaticResource NavRadio}" IsChecked="{Binding SelectedFilter,Converter={StaticResource Equals},ConverterParameter=Schedule}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Schedule" FontSize="12" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Schedules.ActiveCount}" FontSize="11" VerticalAlignment="Center"/></Grid></RadioButton>
     <RadioButton Style="{StaticResource NavRadio}" IsChecked="{Binding SelectedFilter,Converter={StaticResource Equals},ConverterParameter=Calendar}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" Margin="0,0,12,0"/><TextBlock Text="{local:T 'Kalender'}" FontSize="12"/></StackPanel></RadioButton>
     <RadioButton Style="{StaticResource NavRadio}" IsChecked="{Binding SelectedFilter,Converter={StaticResource Equals},ConverterParameter=Overdue}" ToolTip="{local:T 'Terlambat'}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE916;" VerticalAlignment="Center" Foreground="{StaticResource ForegroundDimBrush}"/><TextBlock Grid.Column="1" Text="{local:T 'Terlambat'}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource ForegroundDimBrush}"/><Border Grid.Column="2" Background="{StaticResource BackgroundBrush}" CornerRadius="8" MinWidth="20" Padding="4,2"><TextBlock Text="{Binding OverdueCount}" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource ForegroundDimBrush}"/></Border></Grid></RadioButton>
     <RadioButton Style="{StaticResource NavRadio}" IsChecked="{Binding SelectedFilter,Converter={StaticResource Equals},ConverterParameter=Completed}" ToolTip="{local:T 'Selesai'}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" VerticalAlignment="Center" Foreground="{StaticResource ForegroundDimBrush}"/><TextBlock Grid.Column="1" Text="{local:T 'Selesai'}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource ForegroundDimBrush}"/><Border Grid.Column="2" Background="{StaticResource BackgroundBrush}" CornerRadius="8" MinWidth="20" Padding="4,2"><TextBlock Text="{Binding CompletedCount}" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource ForegroundDimBrush}"/></Border></Grid></RadioButton>
    </StackPanel></ScrollViewer>
   </DockPanel>
   <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}" CornerRadius="18,0,0,0">
    <Grid Margin="30,24,26,20">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,22"><TextBlock Text="{Binding SectionTitle}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding SectionDescription}" Foreground="{StaticResource ForegroundDimBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
     <Grid Grid.Row="1" Visibility="{Binding IsTaskView,Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,18"><TextBox Style="{StaticResource PremiumTextBox}" Text="{Binding SearchQuery,UpdateSourceTrigger=PropertyChanged}" Tag="{local:T 'Cari judul atau deskripsi...'}" Padding="0" Margin="0,0,36,0" AutomationProperties.Name="{local:T 'Cari tugas'}"/><Button HorizontalAlignment="Right" Width="32" Style="{StaticResource QuietButton}" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Command="{Binding ClearSearchCommand}" ToolTip="{local:T 'Hapus pencarian'}"/></Grid>
      <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1" Padding="0,12"><Grid><TextBlock Text="{local:T 'Daftar tugas'}" Foreground="{StaticResource ForegroundDimBrush}" FontSize="11"/><TextBlock Text="{Binding VisibleSummary}" FontSize="11" Foreground="{StaticResource ForegroundDimBrush}" HorizontalAlignment="Right"/></Grid></Border>
      <ListView Grid.Row="2" Style="{StaticResource TaskListStyle}" ItemsSource="{Binding DisplayItems}" ItemTemplateSelector="{StaticResource TaskEntrySelector}"/>
      <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty,Converter={StaticResource BoolToVis}}" Margin="16"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73A;" FontSize="32" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/><TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource ForegroundDimBrush}" Margin="0,18,0,0"/></StackPanel>
     </Grid>
    <local:ScheduleView Grid.Row="1" DataContext="{Binding Schedules}" Visibility="{Binding DataContext.IsSchedule,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource BoolToVis}}"/>
    <local:CalendarView Grid.Row="1" Visibility="{Binding IsCalendar,Converter={StaticResource BoolToVis}}"/>
    <local:SettingsView Grid.Row="1" Visibility="{Binding IsSettings,Converter={StaticResource BoolToVis}}"/>

    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="1" Panel.ZIndex="15" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="500" Margin="20" Padding="18,12" CornerRadius="10" Background="{StaticResource AccentSurface}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Visibility="{Binding HasToast,Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding Toast}" TextWrapping="Wrap"/></Border>
  <Grid Grid.Row="1" Panel.ZIndex="20" Background="#CC090F16" Visibility="{Binding Editor.IsExpanded,Converter={StaticResource BoolToVis}}" KeyboardNavigation.TabNavigation="Cycle"><local:TaskEditor DataContext="{Binding Editor}" Margin="16" MaxWidth="560" MaxHeight="550" VerticalAlignment="Center"/></Grid>
  <local:ConfirmationOverlay Grid.Row="1" Panel.ZIndex="30" Visibility="{Binding IsConfirmationOpen,Converter={StaticResource BoolToVis}}"/>
 </Grid>
 </Border>
</Window>

