<UserControl x:Class="TodoApp.Views.CalendarView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TodoApp.Views">
 <UserControl.Resources><local:CalendarWidthConverter x:Key="CalendarWidth"/></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Calendar.MonthLabel}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal">
   <Button Style="{StaticResource PremiumButton}" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" Command="{Binding Calendar.PreviousCommand}" ToolTip="{local:T 'Bulan sebelumnya'}"/>
   <Button Style="{StaticResource PremiumButton}" Content="{local:T 'Hari ini'}" Command="{Binding Calendar.TodayCommand}" Margin="6,0"/>
   <Button Style="{StaticResource PremiumButton}" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" Command="{Binding Calendar.NextCommand}" ToolTip="{local:T 'Bulan berikutnya'}"/>
  </StackPanel></Grid>
  <ScrollViewer x:Name="CalendarScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
   <Grid Width="{Binding ActualWidth,ElementName=CalendarScroll,Converter={StaticResource CalendarWidth}}"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <ItemsControl ItemsSource="{Binding Calendar.Weekdays}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource ForegroundDimBrush}" FontSize="11" Margin="8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Calendar.Days}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Height="122" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="5" ToolTip="{Binding DateLabel}"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource BackgroundBrush}"/><Style.Triggers><DataTrigger Binding="{Binding InMonth}" Value="False"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <Grid><Grid.RowDefinitions><RowDefinition Height="27"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Width="24" Height="24" HorizontalAlignment="Left" CornerRadius="12"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSurface}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Day}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource ForegroundDimBrush}"/></Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <ItemsControl ItemsSource="{Binding Entries}"><ItemsControl.ItemTemplate><DataTemplate>
          <Button Style="{StaticResource QuietButton}" Padding="5,4" Margin="0,0,0,3" HorizontalContentAlignment="Stretch" Background="{StaticResource SurfaceLightBrush}" Command="{Binding DataContext.OpenCalendarEntryCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding Tooltip}">
           <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Opacity" Value="0.45"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="↻ Schedule" Foreground="{StaticResource AccentBrush}" FontSize="9" Margin="0,0,0,3" Visibility="{Binding IsSchedule,Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource ForegroundBrush}"/>
            <TextBlock Text="{Binding TimeLabel}" FontSize="10" Margin="0,3,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource PriorityHeavyBrush}"/><Style.Triggers><DataTrigger Binding="{Binding EffectivePriority}" Value="Schedule"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding EffectivePriority}" Value="Medium"><Setter Property="Foreground" Value="{StaticResource PriorityMediumBrush}"/></DataTrigger><DataTrigger Binding="{Binding EffectivePriority}" Value="Light"><Setter Property="Foreground" Value="{StaticResource PriorityLightBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
           </StackPanel>
          </Button>
         </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </ScrollViewer>
       </Grid>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </Grid>
  </ScrollViewer>
 </Grid>
</UserControl>
